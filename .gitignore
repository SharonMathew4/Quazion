# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc & OS
.DS_Store
Thumbs.db
Desktop.ini
*.pem

# debug & logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files & secrets (can opt-in for committing if needed)
.env*
!.env.example

# Supabase CLI local state & secrets
supabase/.temp/
supabase/.branches/
.supabase/

# LLM context dumps, local notes, scratch files
*_Context.txt
Repo_Context.txt
scratch/

# IDE & editors
.idea/
.vscode/
*.swp
*.swo

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

