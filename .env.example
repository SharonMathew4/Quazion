# QUAZION Environment Variables
# Copy this file to .env.local and populate with your configuration

# -----------------------------------------------------------------------------
# Supabase Configuration
# -----------------------------------------------------------------------------
# Public client variables (Safe for browser)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key-here

# Private server-only secrets (NEVER prefix with NEXT_PUBLIC_)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# -----------------------------------------------------------------------------
# ORCID OAuth 2.0 Configuration (Academic Verification & Sign-in)
# Register app at: https://orcid.org/developer-tools (or https://sandbox.orcid.org/developer-tools)
# Redirect URI: http://localhost:3000/auth/orcid/callback
# -----------------------------------------------------------------------------
NEXT_PUBLIC_ORCID_CLIENT_ID=APP-XXXXXXXXXXXXXXXX
ORCID_CLIENT_SECRET=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
NEXT_PUBLIC_ORCID_ENV=sandbox # Use "sandbox" for development, "production" for live
NEXT_PUBLIC_APP_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# Feed Synchronization & Cron Security
# -----------------------------------------------------------------------------
# Secret token to authorize periodic background ingestion (/api/cron/sync-feed)
CRON_SECRET=your-cron-secret-token-here
